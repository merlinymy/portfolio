{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run dev -w @portfolio/site",
    "build": "npm run build -w @portfolio/site",
    "preview": "npm run preview -w @portfolio/site",
    "check": "npm run check -w @portfolio/site",
    "face": "node tools/face/build.ts",
    "face:still": "node tools/face/still.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.151.3"
  }
}
