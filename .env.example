# Copy to .env and fill in. Git ignores .env, so the real values stay on this Mac.

# Postgres in Docker (docker-compose.yml). Any long random string; for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Port on this Mac (127.0.0.1 only). 5433 avoids clashing with a Postgres installed some other way.
POSTGRES_PORT=5433

# The model server (services/models), for embeddings and the voice.
MODELS_URL=http://127.0.0.1:8790
