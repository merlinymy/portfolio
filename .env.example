# Copy to .env and fill in. Git ignores .env, so the real values stay on this Mac.

# Postgres in Docker (docker-compose.yml). Any long random string; for example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Port on this Mac (127.0.0.1 only). 5433 avoids clashing with a Postgres installed some other way.
POSTGRES_PORT=5433

# The model server (services/models), for embeddings and the voice.
MODELS_URL=http://127.0.0.1:8790

# The chat backend (apps/server, phase 5). Long random strings: openssl rand -hex 32
# Claude, for the strike check, the answers and the output check (console.anthropic.com).
ANTHROPIC_API_KEY=
# Shared with the Cloudflare Worker, which adds it to every /api request; the api refuses any
# request without it, so the tunnel address is useless on its own.
ORIGIN_SECRET=
# Signs the visitor cookie, so a changed cookie is detected.
COOKIE_SECRET=
# Scrambles IP addresses one way before they're stored.
IP_SALT=
# Cloudflare Turnstile's secret key, from the Cloudflare dashboard. For testing on this Mac only,
# Cloudflare's test key 1x0000000000000000000000000000000AA lets every visitor through; the api
# warns at start when it's in use. Never use it on the live site.
TURNSTILE_SECRET=
# The api's port on this Mac.
API_PORT=8791
# Pages allowed to post to the api, comma-separated (the Origin header browsers send). The default
# is merlinyang.com, its www, the preview site and the dev server on this Mac.
ALLOWED_ORIGINS=
# Monthly Claude spending at which the chat pauses, in dollars (plan §7.7).
SPEND_CAP_USD=18
# Handoff and spending-cap emails. Without RESEND_API_KEY they're saved in knowledge/outbox/ instead.
RESEND_API_KEY=
HANDOFF_TO=
HANDOFF_FROM=Merlin's site <chat@merlinyang.com>
